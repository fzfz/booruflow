{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fzfz/booruflow/schema/docs/locales.schema.json",
  "title": "BooruFlow documentation locale map",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "source_locale", "locales", "topics"],
  "properties": {
    "$schema": { "const": "../schema/docs/locales.schema.json" },
    "schema_version": { "const": 1 },
    "source_locale": { "type": "string", "enum": ["zh-CN", "en", "ja", "es"] },
    "locales": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "root"],
        "properties": {
          "code": { "type": "string", "enum": ["zh-CN", "en", "ja", "es"] },
          "name": { "type": "string", "minLength": 1 },
          "root": { "type": "string", "pattern": "^docs/(zh-CN|en|ja|es)/README\\.md$" }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "translations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "translations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh-CN", "en", "ja", "es"],
            "properties": {
              "zh-CN": { "$ref": "#/$defs/translation" },
              "en": { "$ref": "#/$defs/translation" },
              "ja": { "$ref": "#/$defs/translation" },
              "es": { "$ref": "#/$defs/translation" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": { "type": "string", "pattern": "^docs/(zh-CN|en|ja|es)/.+\\.md$" },
        "status": { "const": "complete" }
      }
    }
  }
}
