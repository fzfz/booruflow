{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure-diff.schema.json",
  "title": "来源页面结构差异",
  "type": "object",
  "additionalProperties": false,
  "required": ["detected_at", "source_name", "stage", "page_url", "severity", "status", "differences"],
  "properties": {
    "detected_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "source_name": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "stage": { "type": "string", "enum": ["discover_catalog", "fetch_details", "download_images", "persist", "report"] },
    "page_url": { "$ref": "common.schema.json#/$defs/sourceUrl" },
    "identity": { "$ref": "common.schema.json#/$defs/identity" },
    "severity": { "type": "string", "enum": ["warning", "stop"] },
    "status": { "type": "string", "enum": ["recorded", "task_stopped"] },
    "differences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "expected", "observed"],
        "properties": {
          "field": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
          "expected": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
          "observed": { "$ref": "common.schema.json#/$defs/nonEmptyText" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "html_path": { "$ref": "common.schema.json#/$defs/rawEvidencePath" },
        "visible_text_path": { "$ref": "common.schema.json#/$defs/rawEvidencePath" }
      },
      "minProperties": 1,
      "description": "本地 HTML 与可见文本证据的相对路径。"
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "properties": { "severity": { "const": "stop" } }, "required": ["severity"] },
          { "properties": { "status": { "const": "task_stopped" } }, "required": ["status"] }
        ]
      },
      "then": {
        "required": ["evidence"],
        "properties": {
          "evidence": { "required": ["html_path", "visible_text_path"] }
        }
      }
    }
  ]
}
