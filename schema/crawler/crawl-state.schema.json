{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"crawl-state.schema.json","title":"采集断点状态","type":"object","additionalProperties":false,
  "required":["state_version","source_name","status","stage","current_task","catalog_cursor","pending_details","pending_images","pending_persists","completed_identities","skipped_identities","failure_queue","consecutive_object_failures","report_path","stop_reason","resume_allowed","updated_at"],
  "properties":{
    "state_version":{"const":3},"source_name":{"$ref":"common.schema.json#/$defs/nonEmptyText"},"status":{"type":"string","enum":["running","paused","failed","completed"]},"stage":{"type":"string","enum":["discover_catalog","fetch_details","download_images","persist","report"]},
    "current_task":{"type":["object","null"],"additionalProperties":false,"properties":{"stage":{"type":"string","enum":["discover_catalog","fetch_details","download_images","persist","report"]},"identity":{"$ref":"common.schema.json#/$defs/identity"},"source_url":{"$ref":"common.schema.json#/$defs/sourceUrl"}}},
    "catalog_cursor":{"type":["string","null"],"minLength":1},"pending_details":{"type":"array","items":{"$ref":"common.schema.json#/$defs/detailTask"},"uniqueItems":true},"pending_images":{"type":"array","items":{"$ref":"common.schema.json#/$defs/imageTask"},"uniqueItems":true},"pending_persists":{"type":"array","items":{"$ref":"common.schema.json#/$defs/persistTask"},"uniqueItems":true},"completed_identities":{"type":"array","items":{"$ref":"common.schema.json#/$defs/identity"},"uniqueItems":true},"skipped_identities":{"type":"array","items":{"$ref":"crawl-error.schema.json"},"uniqueItems":true},"failure_queue":{"type":"array","items":{"$ref":"crawl-error.schema.json"}},"consecutive_object_failures":{"type":"integer","minimum":0,"maximum":3},"report_path":{"anyOf":[{"$ref":"common.schema.json#/$defs/relativeSafePath"},{"type":"null"}]},"stop_reason":{"anyOf":[{"$ref":"common.schema.json#/$defs/errorCode"},{"type":"null"}]},"resume_allowed":{"type":"boolean"},"updated_at":{"$ref":"common.schema.json#/$defs/utcTimestamp"},"extensions":{"$ref":"common.schema.json#/$defs/extensions"}
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"completed"}},"required":["status"]},"then":{"properties":{"stage":{"const":"report"},"catalog_cursor":{"type":"null"},"current_task":{"type":"null"},"pending_details":{"maxItems":0},"pending_images":{"maxItems":0},"pending_persists":{"maxItems":0},"consecutive_object_failures":{"const":0},"stop_reason":{"type":"null"},"resume_allowed":{"const":false}}}},
    {"if":{"properties":{"consecutive_object_failures":{"const":3}},"required":["consecutive_object_failures"]},"then":{"required":["report_path"],"properties":{"status":{"const":"failed"},"stop_reason":{"const":"THREE_CONSECUTIVE_OBJECT_FAILURES"},"report_path":{"$ref":"common.schema.json#/$defs/relativeSafePath"}}}}
  ]
}
