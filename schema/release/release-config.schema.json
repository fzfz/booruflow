{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fzfz/booruflow/blob/main/schema/release/release-config.schema.json",
  "title": "BooruFlow release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "config_version",
    "project_name",
    "repository_https",
    "default_tag",
    "requirements",
    "runtime",
    "release_artifacts"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "../../schema/release/release-config.schema.json" },
    "config_version": { "type": "integer", "const": 1 },
    "project_name": { "type": "string", "const": "BooruFlow" },
    "repository_https": {
      "type": "string",
      "const": "https://github.com/fzfz/booruflow.git"
    },
    "default_tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_minimum", "npm_minimum", "git_minimum", "node_download_url", "git_download_url"],
      "properties": {
        "node_minimum": { "$ref": "#/$defs/semanticVersion" },
        "npm_minimum": { "$ref": "#/$defs/semanticVersion" },
        "git_minimum": { "$ref": "#/$defs/semanticVersion" },
        "node_download_url": { "type": "string", "format": "uri", "pattern": "^https://nodejs\\.org/" },
        "git_download_url": { "type": "string", "format": "uri", "pattern": "^https://git-scm\\.com/" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup_timeout_seconds", "stop_timeout_seconds", "poll_interval_seconds", "pid_file", "shutdown_file", "backup_version_directory", "log_directory", "data_archive_max_bytes", "data_archive_max_entries"],
      "properties": {
        "startup_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "stop_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "poll_interval_seconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "pid_file": { "type": "string", "const": "runtime/run/app.pid" },
        "shutdown_file": { "type": "string", "const": "runtime/run/shutdown.request" },
        "backup_version_directory": { "type": "string", "const": "data/recovery" },
        "log_directory": { "type": "string", "const": "data/diagnostics" },
        "data_archive_max_bytes": { "type": "integer", "minimum": 1 },
        "data_archive_max_entries": { "type": "integer", "minimum": 1 }
      }
    },
    "release_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows_installer", "macos_installer"],
      "properties": {
        "windows_installer": { "type": "string", "const": "install.bat" },
        "macos_installer": { "type": "string", "const": "install.sh" }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
