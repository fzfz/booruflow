{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "application_version": {
      "type": "string",
      "minLength": 1
    },
    "database_version": {
      "type": "integer",
      "minimum": 0
    },
    "exported_at": {
      "type": "string",
      "minLength": 1
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "table",
          "path",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "size"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "application_version",
    "database_version",
    "exported_at",
    "chunks",
    "files"
  ],
  "additionalProperties": false
}
