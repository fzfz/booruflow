{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "ino": {
            "type": "integer",
            "minimum": 0
          },
          "dev": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "ino",
          "dev"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "files"
  ],
  "additionalProperties": false
}
