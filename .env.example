# Copy this file to .env, then set values for this one environment only.
# Do not commit .env or copy it between development/test and production.
# Windows lifecycle commands: start.bat, stop.bat, status.bat
# macOS lifecycle commands: bash start.sh, bash stop.sh, bash status.sh

# 调试和开发使用当前目录的端口配置；为每个环境选择未被占用的端口。
NOOBAI_PUBLIC_PORT=18082
NOOBAI_INTERNAL_PORT=18083
NOOBAI_HTTP_REQUEST_TIMEOUT_MS=15000
NOOBAI_INTERNAL_API_TIMEOUT_MS=5000

# Structured backend diagnostics. The directory is relative to data/.
# debug preserves the complete request lifecycle; info, warn, and error retain progressively fewer events.
NOOBAI_LOG_LEVEL=debug
NOOBAI_LOG_DIRECTORY=diagnostics
NOOBAI_LOG_MAX_FILE_BYTES=10485760
NOOBAI_LOG_MAX_ARCHIVES=5

# Embedding service. It may be different from the reranker service.
NOOBAI_EMBEDDING_BASE_URL=
NOOBAI_EMBEDDING_API_KEY=
NOOBAI_EMBEDDING_MODEL=

# Reranker service. It may be different from the chat and embedding services.
NOOBAI_RERANKER_BASE_URL=
NOOBAI_RERANKER_API_KEY=
NOOBAI_RERANKER_MODEL=
