{
  "name": "booruflow",
  "private": true,
  "version": "0.88.0",
  "description": "本机角色、画风与文生图工作流管理应用。",
  "scripts": {
    "cli:install": "node scripts/install-imagegen-semantic-query.mjs",
    "prod:backup": "node scripts/prod-backup.mjs",
    "prod:restore": "node scripts/prod-restore.mjs",
    "migrate:vector-knn": "node scripts/migrate-vector-knn-index.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "ingest:style-explorer": "node ingest/manual/run-illustrious-noobai-style-explorer.mjs",
    "migrate:media-cutover": "node scripts/run-media-cutover.mjs",
    "test:step-04": "node --test tests/unit/*.test.mjs tests/contract/directory-boundaries.test.mjs",
    "test:step-05": "node --test tests/unit/*.test.mjs tests/contract/*.test.mjs tests/migration/*.test.mjs",
    "test:step-06": "node --test tests/unit/step-06/*.test.mjs tests/integration/step-06/*.test.mjs",
    "test:step-07": "node --test tests/unit/step-07/*.test.mjs tests/integration/step-07/*.test.mjs",
    "test:step-08": "node --test tests/unit/step-08/*.test.mjs",
    "check:step-05": "node scripts/step-05/check-contracts.mjs",
    "test:step-09": "node --test tests/unit/step-09/*.test.mjs",
    "test:step-11": "node --test tests/unit/step-11/*.test.mjs",
    "test:step-12": "node --test tests/unit/step-12/*.test.mjs",
    "test:step-13": "node --test tests/integration/step-13/*.test.mjs",
    "test:prompt-terms": "node --test tests/unit/prompt-term-management.test.mjs tests/unit/prompt-term-management-http.test.mjs tests/unit/prompt-term-categories.test.mjs tests/migration/migration-baseline.test.mjs",
    "test:e2e:manage": "node --test tests/e2e/manage-page.test.mjs",
    "check:test-boundaries": "node scripts/check-static-test-boundaries.mjs",
    "check:test-markdown": "node scripts/check-test-markdown-boundary.mjs",
    "test:contract": "node scripts/run-test-suite.mjs contract",
    "test:unit": "node scripts/run-test-layer.mjs tests/unit/",
    "test:integration": "node scripts/run-test-suite.mjs integration",
    "test:e2e:files": "node scripts/run-e2e-tests.mjs --test-concurrency=1 tests/e2e/",
    "test:e2e": "node scripts/run-test-suite.mjs e2e",
    "repair:compensate-skipped:2x-nz": "node ingest/manual/run-2x-nz-crawlee.mjs --compensate-skipped",
    "test": "node scripts/run-test-suite.mjs all",
    "test:native": "node scripts/run-test-layer.mjs tests/native/",
    "test:migration": "node scripts/run-test-layer.mjs tests/migration/"
  },
  "dependencies": {
    "@crawlee/http": "3.17.0",
    "playwright": "1.62.0",
    "sqlite-vec": "0.1.9",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "license": "MIT",
  "overrides": {
    "brace-expansion": "2.1.4",
    "nanoid": "3.3.18"
  }
}
