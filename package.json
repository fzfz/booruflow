{
  "name": "booruflow",
  "private": true,
  "version": "0.88.0",
  "description": "本机角色、画风与文生图工作流管理应用。",
  "scripts": {
    "cli:install": "node scripts/catalog/install-imagegen-semantic-query.mjs",
    "prod:backup": "node scripts/prod-backup.mjs",
    "prod:restore": "node scripts/prod-restore.mjs",
    "release:tag": "node scripts/release/tag.mjs",
    "ingest:style-explorer": "node ingest/manual/run-illustrious-noobai-style-explorer.mjs",
    "test:prompt-terms": "node --test tests/unit/prompt-term-management.test.mjs tests/unit/prompt-term-management-http.test.mjs tests/unit/prompt-term-categories.test.mjs tests/migration/migration-baseline.test.mjs",
    "test:e2e:manage": "node --test tests/e2e/manage-page.test.mjs",
    "check:test-boundaries": "node scripts/testing/check-static-test-boundaries.mjs",
    "check:test-markdown": "node scripts/testing/check-test-markdown-boundary.mjs",
    "test:contract": "node scripts/testing/run-test-suite.mjs contract",
    "test:unit": "node scripts/testing/run-test-layer.mjs tests/unit/",
    "test:integration": "node scripts/testing/run-test-suite.mjs integration",
    "test:e2e:files": "node scripts/testing/run-e2e-tests.mjs --test-concurrency=1 tests/e2e/",
    "test:e2e": "node scripts/testing/run-test-suite.mjs e2e",
    "repair:compensate-skipped:2x-nz": "node ingest/manual/run-2x-nz-crawlee.mjs --compensate-skipped",
    "test": "node scripts/testing/run-test-suite.mjs all",
    "test:native": "node scripts/testing/run-test-layer.mjs tests/native/",
    "test:migration": "node scripts/testing/run-test-layer.mjs tests/migration/"
  },
  "dependencies": {
    "@crawlee/http": "3.17.0",
    "playwright": "1.62.0",
    "sqlite-vec": "0.1.9",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "license": "MIT",
  "overrides": {
    "brace-expansion": "2.1.4",
    "nanoid": "3.3.18"
  }
}
